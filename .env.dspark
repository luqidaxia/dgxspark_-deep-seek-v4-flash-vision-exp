# DeepSeek V4 Flash Vision-Exp DSpark C12 NVFP4 profile for 2x DGX Spark TP=2
# Adapted from official .env.dspark.example for local flat-dir weights + NJU mirror image.

# Cluster
WORKER_HOST=10.10.12.21
WORKER_DIR=/opt/lexdata-ai/cluster-scripts/dsv4-vision-exp
WORKER_SCRIPT_DIR=
MASTER_ADDR=10.10.12.11
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# RoCE / InfiniBand (head node)
NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_CROSS_NIC=1

# Caches / model
HF_CACHE=/root/.cache/huggingface
WORKER_HF_CACHE=/root/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# Checkpoint: official Vision-Exp (ABLITERATED=0)
ABLITERATED=0
DSPARK_MODEL_OFFICIAL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
DSPARK_MODEL_ABLITERATED=drowzeys/keys-DeepSeekV4Flash-Vision-EXP-ablit
DSPARK_REVISION=86f746b36186f0e567729a5c06a8c918caba82a9
DSPARK_ENCODING_FILE=
SERVED_MODEL_NAME=deepseek-v4-flash-vision-exp
VLLM_HOST=0.0.0.0
VLLM_PORT=4110

# Explicit per-node host IPs (RoCE)
VLLM_HOST_IP=10.10.12.11
WORKER_VLLM_HOST_IP=10.10.12.21

# Prebuilt Anemll DSpark vLLM GX10 image (NJU mirror, same digest as official pin)
DSPARK_VLLM_IMAGE=ghcr.nju.edu.cn/anemll/dspark-vllm-gx10:0.1.1

# Serving profile
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
DSPARK_MAX_INFLIGHT_PREFILLS=1
DSPARK_ISSUE43_SCHED_DIAG=0
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096

# Reasoning / sampling
DSPARK_ENABLE_ASSISTANT_FINAL_HOTFIX=0
DSPARK_ENABLE_ISSUE138_RESPONSES_HISTORY_COMPAT=0
DSPARK_ENABLE_ISSUE136_XGRAMMAR_HOTFIX=0
DSPARK_ENABLE_ISSUE31_GPU_HOTFIX=0
DSPARK_ENABLE_ISSUE141_SPARSE_MLA_CHUNK=0
GPU_MEMORY_UTILIZATION_TEXT=0.835
LIMIT_MM_PER_PROMPT={"image":8}
MTP_NUM_TOKENS=6
DEFAULT_THINKING=max

# Anemll 0.1.1-safe vLLM / runtime knobs
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
TILELANG_CACHE_DIR=/cache/huggingface/tilelang-cache
TRITON_CACHE_DIR=/cache/huggingface/triton-cache
TORCH_FR_BUFFER_SIZE=2000
TORCH_NCCL_DUMP_ON_TIMEOUT=1
TORCH_NCCL_ENABLE_MONITORING=1
TORCH_FR_DUMP_TEMP_FILE=/cache/huggingface/nccl-fr/comm_lib_trace_rank_
TORCH_NCCL_DEBUG_INFO_PIPE_FILE=/tmp/fr_dump_pipe_
B12X_CUTE_COMPILE_CACHE_DIR=/cache/huggingface/b12x-cute-cache
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0

# Compose project name (avoid collision with legacy deepseek-v4-flash instance)
PROJECT_NAME=dsv4-vision-exp
